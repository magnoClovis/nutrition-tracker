{
  "functions": [
    {
      "source": "functions",
      "codebase": "account-deletion",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "test"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hub": {
      "port": 4400
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
