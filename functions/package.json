{
  "name": "trofia-account-deletion-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Administrative account-deletion backend for Trofia.",
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "c14:schema-inventory": "node scripts/c14-schema-inventory.js",
    "c23:copy": "node scripts/c23-legacy-copy.js",
    "c23:delete": "node scripts/c23-legacy-delete.js",
    "c23:inventory": "node scripts/c23-legacy-dry-run.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:emulators": "firebase emulators:exec --config ../firebase.json --project demo-trofia-c22 --only auth,firestore,functions \"npm.cmd test\""
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.27.0"
  }
}
