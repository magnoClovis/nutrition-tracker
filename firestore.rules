rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    function accountDeletionLocked(uid) {
      return exists(
        /databases/$(database)/documents/accountDeletionLocks/$(uid)
      );
    }

    // Only the administrative deletion backend may create or inspect locks.
    match /accountDeletionLocks/{uid} {
      allow read, write: if false;
    }

    // Jobs contain administrative state and sanitized failure metadata only.
    match /accountDeletionJobs/{requestId} {
      allow read, write: if false;
    }

    match /nutrition/{uid} {
      function isOwnUserDoc() {
        return isOwnUser(uid);
      }

      function validRootEnvelope() {
        return request.resource.data.keys().size() <= 128
          && request.resource.data.keys().hasOnly([
            'birthDate', 'gender', 'height', 'activityLevel', 'goalType',
            'goalKg', 'goalWeeks', 'manualCalorieAdjustment',
            'proteinMultiplier', 'bodyFatGoal', 'userName', 'tutorialSeen',
            'language', 'lastLoginAt', 'lastActivityAt',
            'tutorial_most_recent_version_seen', '_storageSchemaVerified',
            '_storageSchemaVerifiedAt', '_legacyCleanupDone',
            'tutorialSeen_main', 'tutorialSeen_diario',
            'tutorialSeen_adicionar', 'tutorialSeen_despensa',
            'tutorialSeen_semana', 'tutorialSeen_metricas', '_dailyDates'
          ])
          && validRootFieldTypes();
      }

      function validRootUpdate() {
        // Historical canonical roots can still contain read-only residual
        // fields from pre-C23 clients. They may survive unchanged, but no
        // client can add, modify, or resurrect one of those fields.
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return request.resource.data.keys().size() <= 128
          && changed.hasOnly([
            'birthDate', 'gender', 'height', 'activityLevel', 'goalType',
            'goalKg', 'goalWeeks', 'manualCalorieAdjustment',
            'proteinMultiplier', 'bodyFatGoal', 'userName', 'tutorialSeen',
            'language', 'lastLoginAt', 'lastActivityAt',
            'tutorial_most_recent_version_seen', '_storageSchemaVerified',
            '_storageSchemaVerifiedAt', '_legacyCleanupDone',
            'tutorialSeen_main', 'tutorialSeen_diario',
            'tutorialSeen_adicionar', 'tutorialSeen_despensa',
            'tutorialSeen_semana', 'tutorialSeen_metricas', '_dailyDates'
          ])
          && validChangedRootFieldTypes(changed);
      }

      function optionalString(field, maximum) {
        return !request.resource.data.keys().hasAny([field])
          || (request.resource.data[field] is string
            && request.resource.data[field].size() <= maximum);
      }

      function optionalNumberOrNull(field) {
        return !request.resource.data.keys().hasAny([field])
          || request.resource.data[field] == null
          || request.resource.data[field] is number
          || (request.resource.data[field] is string
            && request.resource.data[field].size() <= 40);
      }

      function optionalBooleanOrString(field) {
        return !request.resource.data.keys().hasAny([field])
          || request.resource.data[field] is bool
          || (request.resource.data[field] is string
            && request.resource.data[field].size() <= 120);
      }

      function validRootFieldTypes() {
        return optionalString('birthDate', 32)
          && optionalString('gender', 32)
          && optionalString('activityLevel', 40)
          && optionalString('goalType', 40)
          && optionalString('userName', 200)
          && optionalString('language', 12)
          && optionalString('lastLoginAt', 64)
          && optionalString('lastActivityAt', 64)
          && optionalString('_storageSchemaVerifiedAt', 64)
          && optionalNumberOrNull('height')
          && optionalNumberOrNull('goalKg')
          && optionalNumberOrNull('goalWeeks')
          && optionalNumberOrNull('manualCalorieAdjustment')
          && optionalNumberOrNull('proteinMultiplier')
          && optionalNumberOrNull('bodyFatGoal')
          && optionalBooleanOrString('tutorialSeen')
          && optionalBooleanOrString('tutorial_most_recent_version_seen')
          && optionalBooleanOrString('tutorialSeen_main')
          && optionalBooleanOrString('tutorialSeen_diario')
          && optionalBooleanOrString('tutorialSeen_adicionar')
          && optionalBooleanOrString('tutorialSeen_despensa')
          && optionalBooleanOrString('tutorialSeen_semana')
          && optionalBooleanOrString('tutorialSeen_metricas')
          && (!request.resource.data.keys().hasAny(['_storageSchemaVerified'])
            || request.resource.data._storageSchemaVerified is bool)
          && (!request.resource.data.keys().hasAny(['_legacyCleanupDone'])
            || request.resource.data._legacyCleanupDone is bool)
          && (!request.resource.data.keys().hasAny(['_dailyDates'])
            || (request.resource.data._dailyDates is list
              && request.resource.data._dailyDates.size() <= 4000));
      }

      function changedStringIsValid(changed, field, maximum) {
        return !changed.hasAny([field])
          || (request.resource.data.keys().hasAny([field])
            && request.resource.data[field] is string
            && request.resource.data[field].size() <= maximum);
      }

      function changedNumberOrNullIsValid(changed, field) {
        return !changed.hasAny([field])
          || (request.resource.data.keys().hasAny([field])
            && (request.resource.data[field] == null
              || request.resource.data[field] is number
              || (request.resource.data[field] is string
                && request.resource.data[field].size() <= 40)));
      }

      function changedBooleanOrStringIsValid(changed, field) {
        return !changed.hasAny([field])
          || (request.resource.data.keys().hasAny([field])
            && (request.resource.data[field] is bool
              || (request.resource.data[field] is string
                && request.resource.data[field].size() <= 120)));
      }

      function validChangedRootFieldTypes(changed) {
        // Updates validate only fields changed by this request. Historical
        // values — including obsolete known fields with old encodings — may
        // remain unchanged, but any mutation must satisfy the current type.
        return changedStringIsValid(changed, 'birthDate', 32)
          && changedStringIsValid(changed, 'gender', 32)
          && changedStringIsValid(changed, 'activityLevel', 40)
          && changedStringIsValid(changed, 'goalType', 40)
          && changedStringIsValid(changed, 'userName', 200)
          && changedStringIsValid(changed, 'language', 12)
          && changedStringIsValid(changed, 'lastLoginAt', 64)
          && changedStringIsValid(changed, 'lastActivityAt', 64)
          && changedStringIsValid(changed, '_storageSchemaVerifiedAt', 64)
          && changedNumberOrNullIsValid(changed, 'height')
          && changedNumberOrNullIsValid(changed, 'goalKg')
          && changedNumberOrNullIsValid(changed, 'goalWeeks')
          && changedNumberOrNullIsValid(changed, 'manualCalorieAdjustment')
          && changedNumberOrNullIsValid(changed, 'proteinMultiplier')
          && changedNumberOrNullIsValid(changed, 'bodyFatGoal')
          && changedBooleanOrStringIsValid(changed, 'tutorialSeen')
          && changedBooleanOrStringIsValid(changed, 'tutorial_most_recent_version_seen')
          && changedBooleanOrStringIsValid(changed, 'tutorialSeen_main')
          && changedBooleanOrStringIsValid(changed, 'tutorialSeen_diario')
          && changedBooleanOrStringIsValid(changed, 'tutorialSeen_adicionar')
          && changedBooleanOrStringIsValid(changed, 'tutorialSeen_despensa')
          && changedBooleanOrStringIsValid(changed, 'tutorialSeen_semana')
          && changedBooleanOrStringIsValid(changed, 'tutorialSeen_metricas')
          && (!changed.hasAny(['_storageSchemaVerified'])
            || (request.resource.data.keys().hasAny(['_storageSchemaVerified'])
              && request.resource.data._storageSchemaVerified is bool))
          && (!changed.hasAny(['_legacyCleanupDone'])
            || (request.resource.data.keys().hasAny(['_legacyCleanupDone'])
              && request.resource.data._legacyCleanupDone is bool))
          && (!changed.hasAny(['_dailyDates'])
            || (request.resource.data.keys().hasAny(['_dailyDates'])
              && request.resource.data._dailyDates is list
              && request.resource.data._dailyDates.size() <= 4000));
      }

      // User profile/preferences live at nutrition/{uid}.
      allow read: if isOwnUserDoc();
      allow create: if isOwnUserDoc()
        && !accountDeletionLocked(uid)
        && validRootEnvelope();
      allow update: if isOwnUserDoc()
        && !accountDeletionLocked(uid)
        && validRootUpdate();
      // Complete account deletion belongs exclusively to the C22 Admin SDK
      // saga. Client deletion of the root can orphan nested canonical data.
      allow delete: if false;

      // Growing app data lives here to avoid an oversized user document.
      match /data/{key} {
        function validDataKey() {
          return key.matches('^(customGoals|goalHistory|mealTemplates|pantry_v2|suppPantry|trainingByDate|waterCustomPreset|waterGoal|weightHistory|seenVisualUpdateNotice_0\\.8\\.1|tutorialSeen_release-highlights)$')
            || key.matches('^(log_v2|notes|waterIntake|suppLog)_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }

        function validDataEnvelope() {
          return validDataKey()
            && request.resource.data.keys().hasOnly(['value'])
            && request.resource.data.value is string
            && request.resource.data.value.size() <= 900000;
        }

        allow read: if isOwnUserDoc();
        allow create, update: if isOwnUserDoc()
          && !accountDeletionLocked(uid)
          && validDataEnvelope();
        allow delete: if isOwnUserDoc()
          && !accountDeletionLocked(uid);
      }

      // High-concurrency daily records are stored one entry per document. The
      // aggregate data/{key} documents remain readable during C28 migration,
      // but new granular writes use these paths and immutable identities.
      match /days/{date} {
        function validCivilDate() {
          return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }

        function validEntryId(entryId) {
          return entryId.matches('^[A-Za-z0-9_-]{1,128}$');
        }

        function validBaseEntry(entryId) {
          return validCivilDate()
            && validEntryId(entryId)
            && request.resource.data.schemaVersion == 1
            && request.resource.data.id == entryId
            && request.resource.data.date == date
            && request.resource.data.entry is map
            && request.resource.data.entry.id == entryId
            && request.resource.data.updatedAt == request.time;
        }

        function validMealEntry(entryId) {
          return validBaseEntry(entryId)
            && request.resource.data.keys().hasOnly([
              'schemaVersion', 'id', 'date', 'mealKey', 'entry', 'updatedAt'
            ])
            && request.resource.data.mealKey is string
            && request.resource.data.mealKey.size() > 0
            && request.resource.data.mealKey.size() <= 80
            && validMealPayload(entryId, request.resource.data.entry);
        }

        function validNonMealEntry(entryId) {
          return validBaseEntry(entryId)
            && request.resource.data.keys().hasOnly([
              'schemaVersion', 'id', 'date', 'entry', 'updatedAt'
            ]);
        }

        function optionalNutrient(payload, field) {
          return !payload.keys().hasAny([field])
            || payload[field] == null
            || payload[field] is number;
        }

        function validFoodSnapshot(payload) {
          return payload == null || (
            payload is map
            && payload.keys().hasOnly([
              'id', 'name', 'unit', 'protein100', 'kcal100', 'carbs100',
              'sugars100', 'fat100', 'satfat100', 'fiber100', 'salt100',
              'b12_100', 'niacin100', 'phosphorus100', 'vitd100',
              'calcium100', 'iron100', 'potassium100', 'magnesium100',
              'zinc100', 'vitc100'
            ])
            && (payload.id == null
              || (payload.id is string && payload.id.size() <= 256))
            && payload.name is string && payload.name.size() <= 500
            && payload.unit is string && payload.unit.size() <= 40
          );
        }

        function validMealScoreSnapshot(payload) {
          // The local C20/C19 validator owns the detailed scoring semantics.
          // Rules constrain the persisted envelope and primitive types without
          // reimplementing the nutrition algorithm server-side.
          return payload is map
            && payload.keys().hasOnly([
              'algorithmVersion', 'score', 'coverage', 'evaluatedAt',
              'hoursLeft', 'windowHours', 'components', 'confidence',
              'provisional', 'provisionalReasons', 'applicableWeight',
              'mealOccurredAt'
            ])
            && payload.algorithmVersion is string
            && payload.algorithmVersion.size() <= 80
            && payload.score is number
            && payload.coverage is number
            && payload.evaluatedAt is string
            && payload.hoursLeft is number
            && payload.windowHours is number
            && payload.components is map
            && payload.components.keys().hasOnly([
              'protein', 'kcal', 'fiber', 'salt', 'carbs', 'fat'
            ])
            && (!payload.keys().hasAny(['confidence']) || payload.confidence is string)
            && (!payload.keys().hasAny(['provisional']) || payload.provisional is bool)
            && (!payload.keys().hasAny(['provisionalReasons'])
              || (payload.provisionalReasons is list
                && payload.provisionalReasons.size() <= 32))
            && (!payload.keys().hasAny(['applicableWeight'])
              || payload.applicableWeight is number)
            && (!payload.keys().hasAny(['mealOccurredAt'])
              || (payload.mealOccurredAt is string
                && payload.mealOccurredAt.size() <= 64));
        }

        function validMealPayload(entryId, payload) {
          return payload.keys().hasOnly([
              'id', 'foodId', 'name', 'qty', 'unit', 'foodSnapshot',
              'protein', 'kcal', 'carbs', 'sugars', 'fat', 'satfat',
              'fiber', 'salt', 'b12_', 'niacin', 'phosphorus', 'vitd',
              'calcium', 'iron', 'potassium', 'magnesium', 'zinc', 'vitc',
              'time', 'mealEvaluationId', 'mealScoreSnapshot', '_estimated',
              '_estimateSource', '_description'
            ])
            && payload.id == entryId
            && payload.name is string && payload.name.size() <= 500
            && payload.qty is number
            && payload.unit is string && payload.unit.size() <= 40
            && payload.time is string && payload.time.matches('^[0-2][0-9]:[0-5][0-9]$')
            && (!payload.keys().hasAny(['foodId']) || payload.foodId == null
              || (payload.foodId is string && payload.foodId.size() <= 256))
            && (!payload.keys().hasAny(['foodSnapshot'])
              || validFoodSnapshot(payload.foodSnapshot))
            && optionalNutrient(payload, 'protein')
            && optionalNutrient(payload, 'kcal')
            && optionalNutrient(payload, 'carbs')
            && optionalNutrient(payload, 'sugars')
            && optionalNutrient(payload, 'fat')
            && optionalNutrient(payload, 'satfat')
            && optionalNutrient(payload, 'fiber')
            && optionalNutrient(payload, 'salt')
            && optionalNutrient(payload, 'b12_')
            && optionalNutrient(payload, 'niacin')
            && optionalNutrient(payload, 'phosphorus')
            && optionalNutrient(payload, 'vitd')
            && optionalNutrient(payload, 'calcium')
            && optionalNutrient(payload, 'iron')
            && optionalNutrient(payload, 'potassium')
            && optionalNutrient(payload, 'magnesium')
            && optionalNutrient(payload, 'zinc')
            && optionalNutrient(payload, 'vitc')
            && (!payload.keys().hasAny(['mealEvaluationId'])
              || (payload.mealEvaluationId is string
                && payload.mealEvaluationId.size() <= 256))
            && (!payload.keys().hasAny(['mealScoreSnapshot'])
              || validMealScoreSnapshot(payload.mealScoreSnapshot))
            && (!payload.keys().hasAny(['_estimated']) || payload._estimated is bool)
            && (!payload.keys().hasAny(['_estimateSource'])
              || payload._estimateSource.matches('^(image|description)$'))
            && (!payload.keys().hasAny(['_description'])
              || (payload._description is string
                && payload._description.size() <= 4000));
        }

        function validWaterPayload(entryId, payload) {
          return payload.keys().hasOnly(['id', 'ml', 'time'])
            && payload.id == entryId
            && payload.ml is number && payload.ml > 0 && payload.ml <= 100000
            && payload.time is string && payload.time.matches('^[0-2][0-9]:[0-5][0-9]$');
        }

        function validSupplementPayload(entryId, payload) {
          return payload.keys().hasOnly(['id', 'name', 'dose', 'unit', 'time'])
            && payload.id == entryId
            && payload.name is string && payload.name.size() <= 500
            && payload.dose is number
            && payload.unit is string && payload.unit.size() <= 40
            && payload.time is string && payload.time.matches('^[0-2][0-9]:[0-5][0-9]$');
        }

        // Day summary documents are intentionally absent; only their typed
        // entry subcollections are client-visible.
        allow read, write: if false;

        match /meals/{entryId} {
          allow read: if isOwnUserDoc();
          allow create, update: if isOwnUserDoc()
            && !accountDeletionLocked(uid)
            && validMealEntry(entryId);
          allow delete: if isOwnUserDoc()
            && !accountDeletionLocked(uid);
        }

        match /water/{entryId} {
          allow read: if isOwnUserDoc();
          allow create, update: if isOwnUserDoc()
            && !accountDeletionLocked(uid)
            && validNonMealEntry(entryId)
            && validWaterPayload(entryId, request.resource.data.entry);
          allow delete: if isOwnUserDoc()
            && !accountDeletionLocked(uid);
        }

        match /supplements/{entryId} {
          allow read: if isOwnUserDoc();
          allow create, update: if isOwnUserDoc()
            && !accountDeletionLocked(uid)
            && validNonMealEntry(entryId)
            && validSupplementPayload(entryId, request.resource.data.entry);
          allow delete: if isOwnUserDoc()
            && !accountDeletionLocked(uid);
        }

        // A marker is written only after every legacy aggregate entry for one
        // kind has been copied successfully. Once present, readers can ignore
        // the old aggregate without resurrecting a deleted granular entry.
        match /migrations/{kind} {
          allow read: if isOwnUserDoc();
          allow create, update: if isOwnUserDoc()
            && !accountDeletionLocked(uid)
            && kind.matches('^(meal|water|supplement)$')
            && request.resource.data.keys().hasOnly([
              'schemaVersion', 'kind', 'date', 'complete', 'updatedAt'
            ])
            && request.resource.data.schemaVersion == 1
            && request.resource.data.kind == kind
            && request.resource.data.date == date
            && request.resource.data.complete == true
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }
      }
    }

    // No client access exists outside the canonical nutrition/{uid} tree.
    // The C22 Admin SDK cleanup still removes defensive legacy/orphan paths.
  }
}
