{
  "name": "nutrition-tracker",
  "version": "0.8.0-beta",
  "private": true,
  "scripts": {
    "preflight": "powershell -ExecutionPolicy Bypass -File scripts/preflight-release.ps1",
    "audit:i18n": "node scripts/audit-i18n.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:smoke": "playwright test",
    "test": "npm.cmd run preflight && npm.cmd run test:unit && npm.cmd run test:smoke"
  },
  "devDependencies": {
    "@playwright/test": "latest"
  }
}
