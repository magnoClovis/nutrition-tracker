{
  "name": "nutrition-tracker",
  "version": "0.10.0-beta",
  "private": true,
  "scripts": {
    "preflight": "powershell -ExecutionPolicy Bypass -File scripts/preflight-release.ps1",
    "audit:i18n": "node scripts/audit-i18n.js",
    "dev:vite": "vite --config vite.config.js",
    "build:vite": "vite build --config vite.config.js && node scripts/verify-vite-build.js dist",
    "preview:vite": "vite preview --config vite.config.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:smoke:legacy": "playwright test --config=playwright.config.js",
    "test:smoke:vite": "npm.cmd run build:vite && playwright test --config=playwright.vite.config.js",
    "test:smoke": "npm.cmd run test:smoke:legacy && npm.cmd run test:smoke:vite",
    "test:cutover": "npm.cmd run build:vite && playwright test --config=playwright.cutover.config.js",
    "test:pages": "playwright test --config=playwright.pages.config.js",
    "verify:image-worker": "node scripts/verify-image-worker-deployment.js",
    "test": "npm.cmd run preflight && npm.cmd run test:unit && npm.cmd run test:smoke && npm.cmd run test:cutover"
  },
  "dependencies": {
    "@capacitor-firebase/app-check": "8.4.0",
    "@capacitor-mlkit/barcode-scanning": "8.1.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/share": "8.0.1",
    "firebase": "12.18.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.10.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@playwright/test": "latest",
    "@vitejs/plugin-react": "5.1.4",
    "vite": "7.3.6"
  }
}
